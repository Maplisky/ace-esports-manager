{
  "name": "ace-esports-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACE 教练 — 电竞战队经营模拟。core：确定性模拟核心；app：React 播放器与经营界面",
  "scripts": {
    "test": "node --test tests/",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
